<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="subexenta" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="18569594-ff30-49b2-8d91-2fc56aca1618">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="factura" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
     detalleventas.`ventas_idventas` AS detalleventas_idventas,
     detalleventas.`productos_idproductos` AS detalleventas_idproductos,
     detalleventas.`det_precio` AS detalleventas_det_precio,
     detalleventas.`det_cantidad` AS detalleventas_det_cantidad,
     productos.`idproductos` AS productos_idproductos,
     productos.`pro_iva` AS productos_pro_iva,
COALESCE(sum(detalleventas.`det_precio`*detalleventas.`det_cantidad`),0)as subtotal
FROM
     `productos` productos INNER JOIN `detalleventas` detalleventas ON productos.`idproductos` = detalleventas.`productos_idproductos`
where detalleventas.`productos_idproductos`=$P{factura} and productos.`pro_iva`='0']]>
	</queryString>
	<field name="detalleventas_idventas" class="java.lang.Integer"/>
	<field name="detalleventas_idproductos" class="java.lang.Integer"/>
	<field name="detalleventas_det_precio" class="java.lang.Integer"/>
	<field name="detalleventas_det_cantidad" class="java.lang.Integer"/>
	<field name="productos_idproductos" class="java.lang.Integer"/>
	<field name="productos_pro_iva" class="java.lang.String"/>
	<field name="subtotal" class="java.math.BigDecimal"/>
	<background>
		<band splitType="Stretch"/>
	</background>
	<detail>
		<band height="20" splitType="Stretch">
			<textField>
				<reportElement x="0" y="0" width="82" height="20" uuid="3a17065a-2d93-4f51-a460-de3463cbe99d"/>
				<textElement>
					<font fontName="Dubai Medium"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{subtotal}]]></textFieldExpression>
			</textField>
		</band>
	</detail>
</jasperReport>
