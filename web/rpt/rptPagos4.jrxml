<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="rptPagos3" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="980d6666-c9a4-45a0-b298-1442323add7e">
	<property name="ireport.zoom" value="1.3310000000000004"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<queryString>
		<![CDATA[SELECT
    c.idcompras AS id_compras,
    c.com_fecha AS fecha_venta,
    c.com_estado AS estado_venta,
   pr.prov_nombre,
    u.usu_nombre AS nombre_usuario,
    dp.monto AS monto_cobrado
FROM
    pagos p
INNER JOIN proveedores pr ON pr.idproveedores = pr.idproveedores
INNER JOIN detallepagos dp ON p.idpagos = dp.pagos_idpagos
INNER JOIN compras c ON dp.compras_idcompras = c.idcompras
INNER JOIN usuarios u ON c.usuarios_idusuarios = u.idusuarios]]>
	</queryString>
	<field name="id_compras" class="java.lang.Integer"/>
	<field name="fecha_venta" class="java.sql.Date"/>
	<field name="estado_venta" class="java.lang.String"/>
	<field name="prov_nombre" class="java.lang.String">
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
	<field name="nombre_usuario" class="java.lang.String"/>
	<field name="monto_cobrado" class="java.lang.Integer"/>
